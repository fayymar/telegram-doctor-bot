# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Anthropic API key (основная модель)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Groq API key (необязательно — резервная модель)
GROQ_API_KEY=

# Supabase: URL проекта и ключ service_role (НЕ anon!) — Project Settings → API Keys → Legacy
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Секрет для подписи токенов входа (необязательно: по умолчанию выводится из BOT_TOKEN).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Optional
DEBUG=False
FSM_TIMEOUT=1800
