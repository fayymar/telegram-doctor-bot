# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Hugging Face token
# Создать можно в настройках Hugging Face
HF_TOKEN=your_huggingface_token_here

# Основная модель
PRIMARY_AI_MODEL=google/medgemma-4b-it

# Резервные модели через запятую
FALLBACK_AI_MODELS=BioMistral/BioMistral-7B,m42-health/Llama3-Med42-8B

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional
DEBUG=False
FSM_TIMEOUT=1800
